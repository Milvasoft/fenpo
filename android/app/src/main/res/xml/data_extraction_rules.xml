<?xml version="1.0" encoding="utf-8"?>
<!--
    Pairing data is useless without the Keystore key that never leaves the phone, so nothing is
    backed up or moved to a new device; a new phone pairs again (docs/ANDROID.md §13).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
