<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Keys Xcode cannot generate from build settings. The rest comes from INFOPLIST_KEY_* in project.yml. -->
<dict>
	<key>FenpoKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.fenpo.shared</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
	</array>
	<!-- Standard TLS and AES-GCM from Network.framework and CryptoKit only: exempt (Buğra's decision). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIPrefersShowingLanguageSettings</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_fenpo._tcp</string>
	</array>
	<key>NSAccessorySetupKitSupports</key>
	<array>
		<string>Bluetooth</string>
	</array>
	<key>NSAccessorySetupBluetoothServices</key>
	<array>
		<string>1888047E-C8C5-45CC-AAEA-333A8859E79F</string>
	</array>
</dict>
</plist>
