    "action.error.nothingFromPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC’s clipboard has no text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’nin panosunda metin yok."
          }
        }
      }
    },
    "action.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is too long for Bluetooth. Copy a shorter part."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin Bluetooth için çok uzun. Daha kısa bir parça kopyala."
