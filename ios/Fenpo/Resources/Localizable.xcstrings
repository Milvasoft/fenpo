    "hotspot.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC joins your iPhone’s hotspot with one click. iOS doesn’t let apps read the hotspot’s name and password, so type them here once. They stay on this iPhone and go to your PC encrypted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarın iPhone’unun erişim noktasına tek tıkla katılır. iOS erişim noktasının adını ve parolasını uygulamalara göstermez, o yüzden burada bir kez yaz. Bu iPhone’da kalır ve PC’ye şifreli gider."
          }
        }
      }
    },
