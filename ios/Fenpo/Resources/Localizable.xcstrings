    "action.error.transferFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer stopped. Keep both on the same Wi‑Fi and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım yarıda kaldı. İkisini aynı Wi‑Fi’da tutup yeniden dene."
          }
        }
      }
    },
    "action.error.unavailableHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo couldn’t do this in the background. Open Fenpo and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo bunu arka planda yapamadı. Fenpo’yu açıp yeniden dene."
          }
        }
      }
    },
    "action.error.unsupportedByPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo on your PC can’t do this yet. Update Fenpo on Windows."
