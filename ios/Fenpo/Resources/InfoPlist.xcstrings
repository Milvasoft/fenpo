{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo stays connected to your paired PC over Bluetooth to share the clipboard, your PC’s notifications and its media controls, even while Fenpo is in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo; panoyu, bilgisayarının bildirimlerini ve medya kontrollerini paylaşmak için eşleştirdiğin PC’ye Bluetooth üzerinden bağlı kalır, Fenpo arka plandayken de."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo uses the camera to scan the pairing code and to be your PC’s webcam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo kamerayı eşleştirme kodunu okumak ve bilgisayarının web kamerası olmak için kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo connects to your paired PC on the same Wi‑Fi network to send files and photos, show the PC’s shared folders, and use your iPhone as the PC’s webcam or screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo; dosya ve fotoğraf göndermek, PC’nin paylaşılan klasörlerini göstermek ve iPhone’unu PC’nin web kamerası ya da ekranı yapmak için aynı Wi‑Fi ağındaki eşleştirdiğin bilgisayara bağlanır."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo shows your photos on your PC when you browse them there, and sends new screenshots if you turn that on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, bilgisayarında göz attığında fotoğraflarını orada gösterir ve açarsan yeni ekran görüntülerini gönderir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
