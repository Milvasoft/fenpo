{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo keeps the connection to your PC over Bluetooth, so it can receive what the PC sends even when the app is closed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, bilgisayarınla bağlantıyı Bluetooth üzerinden açık tutar; uygulama kapalıyken de PC’nin gönderdiklerini alır."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo uses the camera to scan the pairing code and to be your PC’s webcam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo kamerayı eşleştirme kodunu okumak ve bilgisayarının web kamerası olmak için kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo sends files and photos to your PC on the same Wi-Fi network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, dosya ve fotoğrafları aynı Wi‑Fi ağındaki bilgisayarına gönderir."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo shows your photos on your PC when you browse them there, and sends new screenshots if you turn that on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, bilgisayarında göz attığında fotoğraflarını orada gösterir ve açarsan yeni ekran görüntülerini gönderir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
