{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo keeps the connection to your PC over Bluetooth, so it can receive what the PC sends even when the app is closed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, bilgisayarınla bağlantıyı Bluetooth üzerinden açık tutar; uygulama kapalıyken de PC’nin gönderdiklerini alır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo sends files and photos to your PC on the same Wi-Fi network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, dosya ve fotoğrafları aynı Wi‑Fi ağındaki bilgisayarına gönderir."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo uses the camera to scan the pairing code on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo, bilgisayardaki eşleştirme kodunu okumak için kamerayı kullanır."
          }
        }
      }
    }
  },
  "version": "1.0"
}
