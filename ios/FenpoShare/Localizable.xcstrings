    "share.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t work. Open Fenpo and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olmadı. Fenpo’yu açıp yeniden dene."
          }
        }
      }
    },
    "share.error.wifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach your PC over Wi‑Fi. Make sure both are on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’ye Wi‑Fi üzerinden ulaşılamıyor. İkisinin aynı ağda olduğundan emin ol."
          }
        }
      }
    },
    "share.files.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending files and photos arrives with Wi‑Fi transfer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ve fotoğraf gönderme Wi‑Fi aktarımıyla gelecek."
          }
        }
      }
    },
