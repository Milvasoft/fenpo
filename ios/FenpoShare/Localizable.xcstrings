      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Fenpo with your PC first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Fenpo’yu bilgisayarınla eşleştir."
          }
