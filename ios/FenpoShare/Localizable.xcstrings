{
  "sourceLanguage": "en",
  "strings": {
    "action.error.declinedByPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC declined."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayar kabul etmedi."
          }
        }
      }
    },
    "action.error.notPaired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Fenpo with your PC first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Fenpo’yu bilgisayarınla eşleştir."
          }
        }
      }
    },
    "action.error.transferFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer stopped. Keep both on the same Wi‑Fi and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım yarıda kaldı. İkisini aynı Wi‑Fi’da tutup yeniden dene."
          }
        }
      }
    },
    "action.error.unsupportedByPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo on your PC can’t do this yet. Update Fenpo on Windows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’deki Fenpo bunu henüz yapamıyor. Windows’ta Fenpo’yu güncelle."
          }
        }
      }
    },
    "share.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "share.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t work. Open Fenpo and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olmadı. Fenpo’yu açıp yeniden dene."
          }
        }
      }
    },
    "share.error.wifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach your PC over Wi‑Fi. Make sure both are on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’ye Wi‑Fi üzerinden ulaşılamıyor. İkisinin aynı ağda olduğundan emin ol."
          }
        }
      }
    },
    "share.files.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending files and photos arrives with Wi‑Fi transfer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ve fotoğraf gönderme Wi‑Fi aktarımıyla gelecek."
          }
        }
      }
    },
    "share.notPaired.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired computer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmiş bilgisayar yok"
          }
        }
      }
    },
    "share.nothing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here Fenpo can send yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada Fenpo’nun gönderebileceği bir şey yok."
          }
        }
      }
    },
    "share.openOnPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open on PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’de aç"
          }
        }
      }
    },
    "share.openOnPC.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’de açıldı."
          }
        }
      }
    },
    "share.placeholder.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Fenpo with your PC first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Fenpo’yu bilgisayarınla eşleştir."
          }
        }
      }
    },
    "share.placeholder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to your PC is coming"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayara gönderme geliyor"
          }
        }
      }
    },
    "share.sendFiles %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Send %lld file to PC"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Send %lld files to PC"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dosyayı PC’ye gönder"
                }
              }
            }
          }
        }
      }
    },
    "share.sendFiles.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’ye gönderildi."
          }
        }
      }
    }
  },
  "version": "1.0"
}
