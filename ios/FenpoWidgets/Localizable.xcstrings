{
  "sourceLanguage": "en",
  "strings": {
    "action.error.declinedByPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC declined."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayar kabul etmedi."
          }
        }
      }
    },
    "action.error.emptyText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard is empty. Copy something first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano boş. Önce bir şey kopyala."
          }
        }
      }
    },
    "action.error.notConnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach your PC. Make sure it’s on and nearby."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’ye ulaşılamıyor. Açık ve yakında olduğundan emin ol."
          }
        }
      }
    },
    "action.error.notPaired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Fenpo with your PC first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Fenpo’yu bilgisayarınla eşleştir."
          }
        }
      }
    },
    "action.error.nothingFromPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC’s clipboard has no text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’nin panosunda metin yok."
          }
        }
      }
    },
    "action.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is too long for Bluetooth. Copy a shorter part."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin Bluetooth için çok uzun. Daha kısa bir parça kopyala."
          }
        }
      }
    },
    "action.error.transferFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer stopped. Keep both on the same Wi‑Fi and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım yarıda kaldı. İkisini aynı Wi‑Fi’da tutup yeniden dene."
          }
        }
      }
    },
    "action.error.unavailableHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo couldn’t do this in the background. Open Fenpo and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo bunu arka planda yapamadı. Fenpo’yu açıp yeniden dene."
          }
        }
      }
    },
    "action.error.unsupportedByPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenpo on your PC can’t do this yet. Update Fenpo on Windows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’deki Fenpo bunu henüz yapamıyor. Windows’ta Fenpo’yu güncelle."
          }
        }
      }
    },
    "control.lockPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC’yi kilitle"
          }
        }
      }
    },
