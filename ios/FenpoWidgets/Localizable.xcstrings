    "intent.sendText.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the text on your PC’s clipboard. Use it after “Get Clipboard” in a shortcut."
