<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop desktop4 desktop5 com rescap">

  <!-- Development builds are signed with the self-signed "CN=Fenpo Development" certificate (DECISIONS #37). -->
  <Identity Name="Milvasoft.Fenpo" Publisher="CN=Fenpo Development" Version="1.0.3.0" />

  <Properties>
    <DisplayName>Fenpo</DisplayName>
    <PublisherDisplayName>Milvasoft</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Fenpo"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "fenpo" in Run or a terminal starts the packaged app. -->
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="fenpo.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- Activation of Windows notification buttons (AppNotificationManager). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Fenpo.exe" Arguments="----AppNotificationActivated:" DisplayName="Fenpo notification activator">
              <com:Class Id="E1812019-F81A-4392-8929-AE501A00824F" DisplayName="Fenpo notification activator" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="E1812019-F81A-4392-8929-AE501A00824F" />
        </desktop:Extension>
        <!-- "Send to phone with Fenpo" in File Explorer's right-click menu (Fenpo.ShellExtension.dll, Native AOT). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Fenpo File Explorer command">
              <com:Class Id="6E1C4C2A-6F2B-4E43-9B8C-0C3F1E9E5A11" Path="Fenpo.ShellExtension.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="FenpoSendToPhone" Clsid="6E1C4C2A-6F2B-4E43-9B8C-0C3F1E9E5A11" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="FenpoStartup" Enabled="false" DisplayName="Fenpo" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <!-- The PC's own notifications, for the apps its user picks, go to the phone (pc_notification.proto). -->
    <uap3:Capability Name="userNotificationListener" />
    <DeviceCapability Name="bluetooth" />
    <!-- Joining the phone's hotspot (hotspot.proto). -->
    <DeviceCapability Name="wiFiControl" />
  </Capabilities>

</Package>
