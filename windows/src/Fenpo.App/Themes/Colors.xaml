<?xml version="1.0" encoding="utf-8"?>
<!-- Fenpo colors from design/desktop/desktop.html. Fenpo's own color appears only on the selection
     indicator, badges and primary buttons; everything else follows Windows. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- WinUI derives accent fills from these: light theme uses Dark1, dark theme uses Light2. -->
            <Color x:Key="SystemAccentColor">#E8577E</Color>
            <Color x:Key="SystemAccentColorDark1">#C93A63</Color>
            <Color x:Key="SystemAccentColorDark2">#A82E52</Color>
            <Color x:Key="SystemAccentColorDark3">#7E2240</Color>
            <Color x:Key="SystemAccentColorLight1">#EE7C9A</Color>
            <Color x:Key="SystemAccentColorLight2">#FF86A6</Color>
            <Color x:Key="SystemAccentColorLight3">#F8C8D6</Color>

            <SolidColorBrush x:Key="FenpoAccentBrush" Color="#C93A63" />
            <SolidColorBrush x:Key="FenpoOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FenpoAccentSoftBrush" Color="#1FE8577E" />
            <SolidColorBrush x:Key="FenpoOkBrush" Color="#2F8F6B" />
            <SolidColorBrush x:Key="FenpoErrorBrush" Color="#D64545" />
            <SolidColorBrush x:Key="FenpoCardBrush" Color="#C7FFFFFF" />
            <SolidColorBrush x:Key="FenpoCardSecondaryBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="FenpoStrokeBrush" Color="#141B1F3B" />
            <SolidColorBrush x:Key="FenpoHoverBrush" Color="#0D1B1F3B" />
            <SolidColorBrush x:Key="FenpoTextBrush" Color="#1B1F3B" />
            <SolidColorBrush x:Key="FenpoTextSecondaryBrush" Color="#5D6382" />
            <SolidColorBrush x:Key="FenpoTextTertiaryBrush" Color="#8A90AC" />
            <SolidColorBrush x:Key="FenpoFlyoutBrush" Color="#E6F6F7FC" />
            <SolidColorBrush x:Key="FenpoIslandBrush" Color="#0E1022" />
            <SolidColorBrush x:Key="FenpoSolidBrush" Color="#F3F4FA" />
            <SolidColorBrush x:Key="FenpoBubbleOutBrush" Color="#34A853" />
            <SolidColorBrush x:Key="FenpoOnBubbleOutBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FenpoIslandTextSecondaryBrush" Color="#A3A8C3" />
            <SolidColorBrush x:Key="FenpoDeclineBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="FenpoAcceptBrush" Color="#2FB36B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#E8577E</Color>
            <Color x:Key="SystemAccentColorDark1">#C93A63</Color>
            <Color x:Key="SystemAccentColorDark2">#A82E52</Color>
            <Color x:Key="SystemAccentColorDark3">#7E2240</Color>
            <Color x:Key="SystemAccentColorLight1">#EE7C9A</Color>
            <Color x:Key="SystemAccentColorLight2">#FF86A6</Color>
            <Color x:Key="SystemAccentColorLight3">#F8C8D6</Color>

            <SolidColorBrush x:Key="FenpoAccentBrush" Color="#FF86A6" />
            <SolidColorBrush x:Key="FenpoOnAccentBrush" Color="#1B1F3B" />
            <SolidColorBrush x:Key="FenpoAccentSoftBrush" Color="#24FF86A6" />
            <SolidColorBrush x:Key="FenpoOkBrush" Color="#5CC79A" />
            <SolidColorBrush x:Key="FenpoErrorBrush" Color="#FF8A8A" />
            <SolidColorBrush x:Key="FenpoCardBrush" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="FenpoCardSecondaryBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="FenpoStrokeBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FenpoHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="FenpoTextBrush" Color="#EEF0F8" />
            <SolidColorBrush x:Key="FenpoTextSecondaryBrush" Color="#B4B9D3" />
            <SolidColorBrush x:Key="FenpoTextTertiaryBrush" Color="#7E84A6" />
            <SolidColorBrush x:Key="FenpoFlyoutBrush" Color="#EB24263C" />
            <SolidColorBrush x:Key="FenpoIslandBrush" Color="#0E1022" />
            <SolidColorBrush x:Key="FenpoSolidBrush" Color="#1F2136" />
            <SolidColorBrush x:Key="FenpoBubbleOutBrush" Color="#34A853" />
            <SolidColorBrush x:Key="FenpoOnBubbleOutBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FenpoIslandTextSecondaryBrush" Color="#A3A8C3" />
            <SolidColorBrush x:Key="FenpoDeclineBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="FenpoAcceptBrush" Color="#2FB36B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Brand colors that do not change with the theme (logo, avatars). -->
    <Color x:Key="FenpoInk">#1B1F3B</Color>
    <Color x:Key="FenpoBloom">#E8577E</Color>
    <Color x:Key="FenpoLeaf">#2F8F6B</Color>
    <Color x:Key="FenpoDusk">#4E54C8</Color>
    <Color x:Key="FenpoGlass">#DCE6F5</Color>
    <Color x:Key="FenpoSill">#F6F7FB</Color>

</ResourceDictionary>
