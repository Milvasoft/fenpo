<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page title: Segoe UI Variable Display, 28 px semibold. -->
    <Style x:Key="FenpoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextBrush}" />
    </Style>

    <Style x:Key="FenpoSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextBrush}" />
    </Style>

    <Style x:Key="FenpoSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FenpoCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Card: translucent fill, 1 px stroke, 8 px corners. -->
    <Style x:Key="FenpoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FenpoCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FenpoStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Setting row inside a card: icon, label with optional description, control on the right. -->
    <Style x:Key="FenpoSettingRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style x:Key="FenpoRowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource FenpoStrokeBrush}" />
    </Style>

    <!-- Segmented choice (Theme: System / Light / Dark): radio buttons drawn as one rounded bar. -->
    <Style x:Key="FenpoSegmentStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Segment" Background="Transparent" CornerRadius="6" Padding="10,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Segment.Background" Value="{ThemeResource FenpoHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Segment.Background" Value="{ThemeResource FenpoCardBrush}" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        <Setter Target="Shadow.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Shadow" Opacity="0" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource FenpoStrokeBrush}" Margin="-10,0" />
                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter pill (Notifications: All / Messages / Calls / Other); the checked one takes the accent. -->
    <Style x:Key="FenpoPillStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource FenpoAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource FenpoAccentBrush}" />
                                        <Setter Target="Pill.BorderBrush" Value="Transparent" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource FenpoOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Pill" Height="30" Padding="12,0" CornerRadius="15" Background="{ThemeResource FenpoCardBrush}" BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="1">
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center" Content="{TemplateBinding Content}" Foreground="{ThemeResource FenpoTextBrush}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FenpoSegmentBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FenpoCardSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FenpoStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Banner shown on pages whose feature needs the iPhone app (DECISIONS #36). -->
    <Style x:Key="FenpoNoticeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FenpoAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FenpoStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="FenpoRowIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FenpoRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource FenpoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
