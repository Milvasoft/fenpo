<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Fenpo.App</RootNamespace>
    <AssemblyName>Fenpo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Fenpo.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs keeps a single instance before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied next to the exe: the build output is registered directly as a loose package (tools/Register-Dev.ps1). -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- File Explorer's right-click command is a Native AOT DLL (Fenpo.ShellExtension); it is published for this
       platform and copied next to Fenpo.exe. Native AOT links with Visual Studio's tools, found through vswhere. -->
  <PropertyGroup>
    <ShellExtensionRid Condition="'$(Platform)' == 'ARM64'">win-arm64</ShellExtensionRid>
    <ShellExtensionRid Condition="'$(Platform)' != 'ARM64'">win-x64</ShellExtensionRid>
    <ShellExtensionProject>$(MSBuildThisFileDirectory)..\Fenpo.ShellExtension\Fenpo.ShellExtension.csproj</ShellExtensionProject>
    <ShellExtensionOut>$(MSBuildThisFileDirectory)obj\shell\$(ShellExtensionRid)\</ShellExtensionOut>
  </PropertyGroup>

  <Target Name="PublishShellExtension" BeforeTargets="Build" Inputs="$(ShellExtensionProject);@(ShellExtensionSource)" Outputs="$(ShellExtensionOut)Fenpo.ShellExtension.dll">
    <Exec Command="set &quot;PATH=%PATH%;$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer&quot; &amp;&amp; dotnet publish &quot;$(ShellExtensionProject)&quot; -c Release -r $(ShellExtensionRid) -o &quot;$(ShellExtensionOut).&quot; -nologo -v q" />
  </Target>

  <Target Name="CopyShellExtension" AfterTargets="Build">
    <Copy SourceFiles="$(ShellExtensionOut)Fenpo.ShellExtension.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Fenpo Kamera's media source (Fenpo.VirtualCamera, Native AOT) ships next to Fenpo.exe; Settings › Camera installs
       it with the user's administrator approval (Frame Server does not load packaged COM classes, S7). -->
  <PropertyGroup>
    <VirtualCameraProject>$(MSBuildThisFileDirectory)..\Fenpo.VirtualCamera\Fenpo.VirtualCamera.csproj</VirtualCameraProject>
    <VirtualCameraOut>$(MSBuildThisFileDirectory)obj\vcam\$(ShellExtensionRid)\</VirtualCameraOut>
  </PropertyGroup>

  <ItemGroup>
    <VirtualCameraSource Include="..\Fenpo.VirtualCamera\**\*.cs;..\Fenpo.Core\Camera\CameraRing.cs" Exclude="..\Fenpo.VirtualCamera\obj\**;..\Fenpo.VirtualCamera\bin\**" />
  </ItemGroup>

  <Target Name="PublishVirtualCamera" BeforeTargets="Build" Inputs="$(VirtualCameraProject);@(VirtualCameraSource)" Outputs="$(VirtualCameraOut)Fenpo.VirtualCamera.dll">
    <Exec Command="set &quot;PATH=%PATH%;$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer&quot; &amp;&amp; dotnet publish &quot;$(VirtualCameraProject)&quot; -c Release -r $(ShellExtensionRid) -o &quot;$(VirtualCameraOut).&quot; -nologo -v q" />
  </Target>

  <!-- The credential provider for unlocking with the phone is C++ (LogonUI loads no managed runtime); Visual Studio's
       MSBuild builds it and the DLL ships next to Fenpo.exe. Settings installs it with administrator approval. -->
  <PropertyGroup>
    <CredentialProviderDir>$(MSBuildThisFileDirectory)..\..\native\Fenpo.CredentialProvider\</CredentialProviderDir>
  </PropertyGroup>

  <ItemGroup>
    <CredentialProviderSource Include="$(CredentialProviderDir)*.cpp;$(CredentialProviderDir)*.h;$(CredentialProviderDir)*.rc;$(CredentialProviderDir)*.def;$(CredentialProviderDir)*.bmp;$(CredentialProviderDir)*.vcxproj" />
  </ItemGroup>

  <Target Name="BuildCredentialProvider" BeforeTargets="Build" Inputs="@(CredentialProviderSource)" Outputs="$(CredentialProviderDir)bin\$(Platform)\Fenpo.CredentialProvider.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Build-Native.ps1&quot; -Platform $(Platform)" />
  </Target>

  <Target Name="CopyCredentialProvider" AfterTargets="Build">
    <Copy SourceFiles="$(CredentialProviderDir)bin\$(Platform)\Fenpo.CredentialProvider.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVirtualCamera" AfterTargets="Build">
    <Copy SourceFiles="$(VirtualCameraOut)Fenpo.VirtualCamera.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ShellExtensionSource Include="..\Fenpo.ShellExtension\**\*.cs" Exclude="..\Fenpo.ShellExtension\obj\**;..\Fenpo.ShellExtension\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenpo.Core\Fenpo.Core.csproj" />
    <ProjectReference Include="..\Fenpo.Bluetooth\Fenpo.Bluetooth.csproj" />
    <ProjectReference Include="..\Fenpo.Transport\Fenpo.Transport.csproj" />
  </ItemGroup>

</Project>
