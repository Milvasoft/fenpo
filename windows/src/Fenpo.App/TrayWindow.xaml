<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fenpo.App.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    Title="Fenpo">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="QuickToggleStyle" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="64" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>

        <!-- Design "Tepsi paneli": phone, quick toggles, now playing, footer. -->
        <StackPanel x:Name="Panel" Padding="16" VerticalAlignment="Top">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="56" CornerRadius="9" BorderThickness="2" BorderBrush="#2A2E48">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.4,0" EndPoint="0.6,1">
                            <GradientStop Color="#5B63D6" Offset="0" />
                            <GradientStop Color="#2B2F5A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" />
                    <HyperlinkButton Content="{x:Bind ViewModel.OtherPhoneText, Mode=OneWay}" Command="{x:Bind ViewModel.UseOtherPhoneCommand}" Visibility="{x:Bind ViewModel.HasOtherPhone, Mode=OneWay}" Padding="0" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" x:Uid="Tray_Settings" Padding="8" VerticalAlignment="Center" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ToggleButton Style="{StaticResource QuickToggleStyle}" IsChecked="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                        <TextBlock x:Uid="Tray_Notifications" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1" Style="{StaticResource QuickToggleStyle}" IsChecked="{x:Bind ViewModel.ShareClipboard, Mode=TwoWay}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE77F;" FontSize="16" />
                        <TextBlock x:Uid="Tray_Clipboard" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="2" Style="{StaticResource QuickToggleStyle}" IsChecked="{x:Bind ViewModel.ProximityLock, Mode=TwoWay}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                        <TextBlock x:Uid="Tray_ProximityLock" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Row="1" Style="{StaticResource QuickToggleStyle}" IsChecked="{x:Bind ViewModel.FocusSync, Mode=TwoWay}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE708;" FontSize="16" />
                        <TextBlock x:Uid="Tray_Focus" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <!-- These need the iPhone app (DECISIONS #36): visible, with what they need. -->
                <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickToggleStyle}" IsEnabled="{x:Bind ViewModel.AppConnected, Mode=OneWay}" x:Uid="Tray_Hotspot">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE704;" FontSize="16" />
                        <TextBlock x:Uid="Tray_HotspotText" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Height="64" CornerRadius="6" Padding="4" FontSize="12" IsEnabled="{x:Bind ViewModel.CanRing, Mode=OneWay}" Command="{x:Bind ViewModel.RingCommand}" x:Uid="Tray_Ring">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE767;" FontSize="16" />
                        <Grid HorizontalAlignment="Center">
                            <TextBlock x:Uid="Tray_RingText" Visibility="{x:Bind ViewModel.NotRinging, Mode=OneWay}" />
                            <TextBlock x:Uid="Tray_Ringing" Visibility="{x:Bind ViewModel.IsRinging, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource FenpoCardStyle}" Padding="10" CornerRadius="6" Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E8577E" Offset="0" />
                                <GradientStop Color="#4E54C8" Offset="0.55" />
                                <GradientStop Color="#2F8F6B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Padding="8" Command="{x:Bind ViewModel.PlayPauseCommand}" x:Uid="Media_PlayPause">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                        <Button Padding="8" Command="{x:Bind ViewModel.NextCommand}" x:Uid="Media_Next">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="Tray_Open" HorizontalAlignment="Right" Padding="0" FontSize="13" Click="OnOpenClick" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
