<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fenpo.App.LaserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    Title="Fenpo">

    <Window.SystemBackdrop>
        <helpers:TransparentBackdrop />
    </Window.SystemBackdrop>

    <!-- The phone's laser pointer: a glowing dot over the PC's screen. -->
    <Grid>
        <Ellipse Width="36" Height="36" Fill="{ThemeResource FenpoAccentBrush}" Opacity="0.25" />
        <Ellipse Width="16" Height="16" Fill="{ThemeResource FenpoAccentBrush}" Stroke="{ThemeResource FenpoOnAccentBrush}" StrokeThickness="2" />
    </Grid>
</Window>
