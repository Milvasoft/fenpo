<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fenpo.App.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    Title="Fenpo">

    <Window.SystemBackdrop>
        <helpers:TransparentBackdrop />
    </Window.SystemBackdrop>

    <!-- Design "Ada": incoming call at the top center. The window is transparent; the Border draws the pill. -->
    <Border x:Name="Root" Background="{ThemeResource FenpoIslandBrush}" CornerRadius="38" RequestedTheme="Dark" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="Grow" />
        </Border.RenderTransform>
        <Border.Resources>
            <!-- Design: the pill grows out of a small one (240 x 40) and fades in. -->
            <Storyboard x:Name="AppearStoryboard">
                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" From="0.57" To="1" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" From="0.53" To="1" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
            </Storyboard>

            <!-- Design: a green ring around the pill fades out again and again while the phone rings. -->
            <Storyboard x:Name="RingStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Round call button drawn as an ellipse: the default template's elevation border breaks up at this radius. -->
            <Style x:Key="CallButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Circle.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Circle.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
        <Border x:Name="Pulse" CornerRadius="38" BorderThickness="1.5" BorderBrush="{ThemeResource FenpoIslandRingBrush}" Opacity="0" IsHitTestVisible="False" />
        <Grid Padding="14,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{x:Bind CallerFill}" />
                <TextBlock Text="{x:Bind CallerInitial}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind CallerName}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind CallerDetail}" FontSize="12" Foreground="{ThemeResource FenpoIslandTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" x:Uid="Island_Decline" Style="{StaticResource CallButtonStyle}" Background="{ThemeResource FenpoDeclineBrush}" Click="OnDeclineClick">
                <!-- Hang-up: the handset turned on its side. -->
                <FontIcon Glyph="&#xE717;" FontSize="20" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="135" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button Grid.Column="3" x:Uid="Island_Answer" Style="{StaticResource CallButtonStyle}" Background="{ThemeResource FenpoAcceptBrush}" Click="OnAnswerClick" Visibility="{x:Bind CanAnswer}">
                <FontIcon Glyph="&#xE717;" FontSize="20" />
            </Button>
        </Grid>
        </Grid>
    </Border>
</Window>
