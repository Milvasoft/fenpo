<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fenpo.App.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fenpo">

    <!-- Design "Ada": incoming call at the top center. The window region gives it the pill shape. -->
    <Grid x:Name="Root" Background="{ThemeResource FenpoIslandBrush}" Padding="14,0" ColumnSpacing="10" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="48" Height="48" CornerRadius="24" Background="{x:Bind CallerFill, Mode=OneWay}" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind CallerInitial, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind CallerName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind CallerDetail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource FenpoIslandTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" x:Uid="Island_Decline" Width="48" Height="48" CornerRadius="24" Padding="0" BorderThickness="0" Background="{ThemeResource FenpoDeclineBrush}" Foreground="White" VerticalAlignment="Center" Click="OnDeclineClick">
            <FontIcon Glyph="&#xE778;" FontSize="20" />
        </Button>
        <Button Grid.Column="3" x:Uid="Island_Answer" Width="48" Height="48" CornerRadius="24" Padding="0" BorderThickness="0" Background="{ThemeResource FenpoAcceptBrush}" Foreground="White" VerticalAlignment="Center" Click="OnAnswerClick" Visibility="{x:Bind CanAnswer, Mode=OneWay}">
            <FontIcon Glyph="&#xE717;" FontSize="20" />
        </Button>
    </Grid>
</Window>
