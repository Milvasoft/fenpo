<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    xmlns:vm="using:Fenpo.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,28" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource FenpoPageTitleStyle}" Margin="0,0,0,4" />

            <!-- Language restart banner -->
            <Border Style="{StaticResource FenpoNoticeStyle}" Padding="14,10" Visibility="{x:Bind ViewModel.RestartPending, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource FenpoAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource FenpoTextBrush}">
                        <Run x:Uid="LanguageRestart_Title" FontWeight="SemiBold" />
                        <Run Text="{x:Bind ViewModel.RestartMessage, Mode=OneWay}" />
                    </TextBlock>
                    <Button Grid.Column="2" x:Uid="LanguageRestart_Now" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestartCommand}" />
                    <Button Grid.Column="3" x:Uid="LanguageRestart_Later" Command="{x:Bind ViewModel.DismissRestartCommand}" />
                </Grid>
            </Border>

            <!-- Appearance and language -->
            <StackPanel>
                <TextBlock x:Uid="Settings_AppearanceHeader" Style="{StaticResource FenpoSectionHeaderStyle}" />
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE706;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Theme" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_ThemeHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="270" Style="{StaticResource FenpoSegmentBarStyle}">
                                <Grid ColumnSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ThemeSystem" x:Uid="Theme_System" GroupName="Theme" Style="{StaticResource FenpoSegmentStyle}" Checked="OnThemeChecked" />
                                    <RadioButton x:Name="ThemeLight" x:Uid="Theme_Light" Grid.Column="1" GroupName="Theme" Style="{StaticResource FenpoSegmentStyle}" Checked="OnThemeChecked" />
                                    <RadioButton x:Name="ThemeDark" x:Uid="Theme_Dark" Grid.Column="2" GroupName="Theme" Style="{StaticResource FenpoSegmentStyle}" Checked="OnThemeChecked" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Language" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_LanguageHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" x:Uid="LanguageCombo">
                                <ComboBoxItem Content="{x:Bind ViewModel.SystemLanguageLabel}" />
                                <ComboBoxItem Content="Türkçe" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Features -->
            <StackPanel>
                <TextBlock x:Uid="Settings_FeaturesHeader" Style="{StaticResource FenpoSectionHeaderStyle}" />
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F8;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Startup" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StartupHint, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.StartupChangeable, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_StartupToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA8F;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Notifications" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_NotificationsHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_NotificationsToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE717;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Calls" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_CallsHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowIncomingCalls, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_CallsToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE995;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_CallRing" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_CallRingHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.RingForCalls, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_CallRingToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xF0E3;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Clipboard" Style="{StaticResource FenpoRowLabelStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShareClipboard, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_ClipboardToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Media" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_MediaHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MediaControl, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_MediaToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sharing with the phone: the PC's notifications, shared folders, LocalSend -->
            <StackPanel>
                <TextBlock x:Uid="Settings_SharingHeader" Style="{StaticResource FenpoSectionHeaderStyle}" />
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Sharing_PcNotifications" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Sharing_PcNotificationsHint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <DropDownButton Grid.Column="2" x:Uid="Sharing_PickApps" Margin="0,0,12,0" VerticalAlignment="Center" IsEnabled="{x:Bind Sharing.PcNotificationsToPhone, Mode=OneWay}">
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="320" Spacing="4">
                                            <TextBlock x:Uid="Sharing_PickAppsTitle" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="Sharing_NoApps" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind Sharing.NoApps, Mode=OneWay}" />
                                            <ScrollViewer MaxHeight="360">
                                                <ItemsControl ItemsSource="{x:Bind Sharing.Apps}" IsTabStop="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PcNotificationAppItem">
                                                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Send, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Sharing.PcNotificationsToPhone, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Sharing_PcNotificationsToggle" />
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Sharing.HasNotificationsNotice, Mode=OneWay}" Message="{x:Bind Sharing.NotificationsNotice, Mode=OneWay}" Severity="Warning" IsClosable="False" Margin="16,0,16,12" />
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Sharing_Folders" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Sharing_FoldersHint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Uid="Sharing_AddFolder" VerticalAlignment="Center" Click="OnAddSharedFolderClick" />
                        </Grid>
                        <TextBlock x:Uid="Sharing_NoFolders" Style="{StaticResource FenpoCaptionTextStyle}" Margin="56,0,16,12" Visibility="{x:Bind Sharing.NoFolders, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Sharing.Folders}" Margin="56,0,16,8" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharedFolderItem">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource FenpoTextBrush}" />
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource FenpoCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Uid="Sharing_RemoveFolder" Tag="{x:Bind}" Click="OnRemoveSharedFolderClick" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Sharing_LocalSend" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Sharing_LocalSendHint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Sharing.LocalSendVisible, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Sharing_LocalSendToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Proximity and focus -->
            <StackPanel>
                <TextBlock x:Uid="Settings_ProximityHeader" Style="{StaticResource FenpoSectionHeaderStyle}" />
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_ProximityLock" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_ProximityLockHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ProximityLock, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_ProximityLockToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE928;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Unlock" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_UnlockHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsEnabled="False" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_UnlockToggle" />
                        </Grid>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE708;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Focus" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock x:Uid="Settings_FocusHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.FocusSync, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Settings_FocusToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Device -->
            <StackPanel>
                <TextBlock x:Uid="Settings_DeviceHeader" Style="{StaticResource FenpoSectionHeaderStyle}" />
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8EA;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DeviceHint, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Uid="Settings_Pair" VerticalAlignment="Center" Click="OnPairClick" Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.IsPaired), Mode=OneWay}" />
                            <Button Grid.Column="2" x:Uid="Settings_ForgetPhone" Tag="Active" VerticalAlignment="Center" Click="OnForgetClick" Visibility="{x:Bind ViewModel.IsPaired, Mode=OneWay}" />
                        </Grid>
                        <!-- The other paired phone: Fenpo uses one at a time. -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasOtherPhone, Mode=OneWay}">
                            <Border Style="{StaticResource FenpoRowDividerStyle}" />
                            <Grid Style="{StaticResource FenpoSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8EA;" Style="{StaticResource FenpoRowIconStyle}" Foreground="{ThemeResource FenpoTextTertiaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.OtherDeviceTitle, Mode=OneWay}" Style="{StaticResource FenpoRowLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.OtherDeviceHint, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Uid="Settings_ForgetPhone" Tag="Other" Click="OnForgetClick" />
                                    <Button x:Uid="Settings_UsePhone" Command="{x:Bind ViewModel.UseOtherPhoneCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <!-- Another phone, or Fenpo on this one again (QR code): always reachable. -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsPaired, Mode=OneWay}">
                            <Border Style="{StaticResource FenpoRowDividerStyle}" />
                            <Grid Style="{StaticResource FenpoSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE710;" Style="{StaticResource FenpoRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings_AddPhone" Style="{StaticResource FenpoRowLabelStyle}" />
                                    <TextBlock x:Uid="Settings_AddPhoneHint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Uid="Settings_ConnectApp" Click="OnConnectAppClick" />
                                    <Button x:Uid="Settings_AddPhoneButton" Click="OnPairClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Style="{StaticResource FenpoRowDividerStyle}" />
                        <Grid Style="{StaticResource FenpoSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource FenpoRowIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_IncomingFiles" Style="{StaticResource FenpoRowLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.IncomingFolder, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Uid="Settings_ChangeFolder" VerticalAlignment="Center" Click="OnChangeFolderClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
