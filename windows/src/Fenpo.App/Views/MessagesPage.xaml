<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    xmlns:vm="using:Fenpo.App.ViewModels">

    <Page.Resources>
        <helpers:BubbleTemplateSelector x:Key="BubbleSelector">
            <helpers:BubbleTemplateSelector.Day>
                <DataTemplate x:DataType="vm:BubbleItem">
                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource FenpoCaptionTextStyle}" HorizontalAlignment="Center" Margin="0,8" />
                </DataTemplate>
            </helpers:BubbleTemplateSelector.Day>
            <helpers:BubbleTemplateSelector.Incoming>
                <DataTemplate x:DataType="vm:BubbleItem">
                    <Grid HorizontalAlignment="Left" MaxWidth="460">
                        <Border Padding="12,8" CornerRadius="16,16,16,6" Background="{ThemeResource FenpoCardBrush}" BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource FenpoTextBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </helpers:BubbleTemplateSelector.Incoming>
            <helpers:BubbleTemplateSelector.Outgoing>
                <DataTemplate x:DataType="vm:BubbleItem">
                    <Grid HorizontalAlignment="Right" MaxWidth="460">
                        <Border Padding="12,8" CornerRadius="16,16,6,16" Background="{ThemeResource FenpoBubbleOutBrush}">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource FenpoOnBubbleOutBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </helpers:BubbleTemplateSelector.Outgoing>
        </helpers:BubbleTemplateSelector>
    </Page.Resources>

    <!-- Design "Mesajlar": conversations on the left, the open conversation on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="0,0,1,0" Padding="8,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,0,8,12">
                <TextBlock x:Uid="MessagesTitle" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button x:Uid="Messages_Refresh" Padding="8" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button x:Uid="Messages_New" Padding="8" Click="OnNewClick" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Conversations}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationRowViewModel">
                        <Grid ColumnSpacing="10" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" CornerRadius="20" Background="{x:Bind Fill}">
                                <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Preview}" FontSize="13" Foreground="{ThemeResource FenpoTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{ThemeResource FenpoAccentBrush}" Visibility="{x:Bind HasUnread}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource FenpoCaptionTextStyle}" Visibility="{x:Bind ShowTime}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Not connected, connecting, or the phone refused: what to do. -->
        <StackPanel Grid.Column="1" Visibility="{x:Bind ViewModel.ShowState, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="8" Padding="24">
            <FontIcon Glyph="&#xE8BD;" FontSize="32" Foreground="{ThemeResource FenpoTextTertiaryBrush}" Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.IsConnecting), Mode=OneWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" Width="28" Height="28" Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StateTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource FenpoTextBrush}" />
            <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Style="{StaticResource FenpoSecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Visibility="{x:Bind ViewModel.ShowEmptyThread, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <FontIcon Glyph="&#xE8BD;" FontSize="32" Foreground="{ThemeResource FenpoTextTertiaryBrush}" />
            <TextBlock x:Uid="Messages_PickConversation" Style="{StaticResource FenpoSecondaryTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="20,0" ColumnSpacing="12" BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" CornerRadius="16" Background="{x:Bind ViewModel.Selected.Fill, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Initial, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ThreadSubtitle, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ThreadScroller" Grid.Row="1" Padding="24,12,24,20">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Messages_HistoryNote" Style="{StaticResource FenpoCaptionTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Bubbles}" ItemTemplateSelector="{StaticResource BubbleSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="20,8,20,16" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.SendError, Mode=OneWay}" Foreground="{ThemeResource FenpoErrorBrush}" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind helpers:BindHelpers.VisibleWhenText(ViewModel.SendError), Mode=OneWay}" />
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanReply, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="Messages_Draft" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="19" MinHeight="38" Padding="14,8" TextWrapping="Wrap" MaxHeight="140" AcceptsReturn="False" KeyDown="OnDraftKeyDown" />
                    <Button Grid.Column="1" x:Uid="Messages_Send" Width="38" Height="38" CornerRadius="19" Padding="0" Background="{ThemeResource FenpoBubbleOutBrush}" Foreground="{ThemeResource FenpoOnBubbleOutBrush}" BorderThickness="0" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SendCommand}">
                        <FontIcon Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.ReplyHint, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.CanReply), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
