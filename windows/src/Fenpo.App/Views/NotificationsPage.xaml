<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fenpo.App.Helpers"
    xmlns:vm="using:Fenpo.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:NotificationRowViewModel">
            <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource FenpoStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" CornerRadius="16" Background="{x:Bind SenderBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind SenderInitial}" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                    <TextBlock Text="{x:Bind Message}" FontSize="13" Foreground="{ThemeResource FenpoTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="4" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" Visibility="{x:Bind CanDismiss}">
                        <Button Content="{x:Bind PositiveLabel}" Tag="{x:Bind Id}" Visibility="{x:Bind HasPositive}" Click="OnPositiveClick" />
                        <Button x:Uid="Notification_DismissButton" Tag="{x:Bind Id}" Click="OnDismissClick" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource FenpoCaptionTextStyle}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,28">
            <TextBlock x:Uid="NotificationsTitle" Style="{StaticResource FenpoPageTitleStyle}" />

            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <RadioButton x:Name="FilterAll" x:Uid="Filter_All" GroupName="Filter" Style="{StaticResource FenpoPillStyle}" Checked="OnFilterChecked" IsChecked="True" />
                    <RadioButton x:Name="FilterMessages" x:Uid="Filter_Messages" GroupName="Filter" Style="{StaticResource FenpoPillStyle}" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterCalls" x:Uid="Filter_Calls" GroupName="Filter" Style="{StaticResource FenpoPillStyle}" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterOther" x:Uid="Filter_Other" GroupName="Filter" Style="{StaticResource FenpoPillStyle}" Checked="OnFilterChecked" />
                </StackPanel>
                <Button x:Uid="Notifications_ClearAll" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ClearAllCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationGroupViewModel">
                        <Border Style="{StaticResource FenpoCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="16,12" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="22" Height="22" CornerRadius="6" Background="{x:Bind AppBrush}">
                                        <TextBlock Text="{x:Bind AppInitial}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{x:Bind AppIcon}" Visibility="{x:Bind HasAppIcon}" Stretch="UniformToFill" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind AppName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource FenpoTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" Style="{StaticResource FenpoCaptionTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Margin="0,24" Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xEA8F;" FontSize="32" Foreground="{ThemeResource FenpoTextTertiaryBrush}" />
                <TextBlock x:Uid="Notifications_Empty" HorizontalAlignment="Center" Style="{StaticResource FenpoSecondaryTextStyle}" />
            </StackPanel>

            <TextBlock x:Uid="Notifications_Footnote" Style="{StaticResource FenpoCaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
