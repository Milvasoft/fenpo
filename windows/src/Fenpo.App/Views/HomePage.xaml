<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fenpo.App.Controls"
    xmlns:helpers="using:Fenpo.App.Helpers"
    xmlns:vm="using:Fenpo.App.ViewModels">

    <Page.Resources>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource FenpoCardSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FenpoStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource FenpoCardSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FenpoStrokeBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <DataTemplate x:Key="NotificationRowTemplate" x:DataType="vm:NotificationRowViewModel">
            <Grid Padding="16,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" CornerRadius="8" Background="{x:Bind AppBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind AppInitial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind AppIcon}" Visibility="{x:Bind HasAppIcon}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Message}" FontSize="13" Foreground="{ThemeResource FenpoTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource FenpoCaptionTextStyle}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,28" Spacing="16">
            <InfoBar x:Uid="Notifications_Refused" IsOpen="{x:Bind ViewModel.NotificationsRefused, Mode=OneWay}" Severity="Warning" IsClosable="False" />

            <!-- Hero: phone illustration, status, actions -->
            <Border Style="{StaticResource FenpoCardStyle}" Padding="28,20">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="128" Height="256" CornerRadius="34" Padding="7" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A3F5C" Offset="0" />
                                <GradientStop Color="#1B1F3B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid CornerRadius="28">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                    <GradientStop Color="#F3A3BB" Offset="0" />
                                    <GradientStop Color="#5B63D6" Offset="0.45" />
                                    <GradientStop Color="#2B2F5A" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Border Width="50" Height="15" CornerRadius="9" Background="Black" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <StackPanel VerticalAlignment="Top" Margin="0,41,0,0">
                                <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" FontSize="38" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.DateText, Mode=OneWay}" FontSize="11" Foreground="White" Opacity="0.85" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border VerticalAlignment="Bottom" Margin="8,0,8,30" Padding="8,6" CornerRadius="12" Background="#38FFFFFF" Visibility="{x:Bind helpers:BindHelpers.VisibleWhenText(ViewModel.MiniTitle), Mode=OneWay}">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.MiniTitle, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.MiniMessage, Mode=OneWay}" FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                        <HyperlinkButton Content="{x:Bind ViewModel.OtherPhoneText, Mode=OneWay}" Command="{x:Bind ViewModel.UseOtherPhoneCommand}" Visibility="{x:Bind ViewModel.HasOtherPhone, Mode=OneWay}" Padding="0" FontSize="13" Margin="0,2,0,0" />

                        <!-- Not paired: one clear way forward -->
                        <StackPanel Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.IsPaired), Mode=OneWay}" Margin="0,12,0,0" Spacing="12">
                            <TextBlock x:Uid="Home_PairHint" Style="{StaticResource FenpoSecondaryTextStyle}" />
                            <Button x:Uid="Home_PairButton" Style="{StaticResource AccentButtonStyle}" Click="OnPairClick" />
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.IsPaired, Mode=OneWay}">
                            <controls:WrapPanel Spacing="8" LineSpacing="8" Margin="0,12,0,18">
                                <Border Style="{StaticResource ChipStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Grid Width="22" Height="11" VerticalAlignment="Center">
                                            <Border BorderBrush="{ThemeResource FenpoTextBrush}" BorderThickness="1.4" CornerRadius="3" />
                                            <Border Background="{ThemeResource FenpoOkBrush}" CornerRadius="1" Margin="2.5" HorizontalAlignment="Left" Width="{x:Bind ViewModel.BatteryFill, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource FenpoTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipStyle}" Opacity="{x:Bind helpers:BindHelpers.DimWhenOff(ViewModel.BluetoothOn), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource FenpoOkBrush}" />
                                        <FontIcon Glyph="&#xE702;" FontSize="13" />
                                        <TextBlock x:Uid="Chip_Bluetooth" FontSize="13" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipStyle}" Opacity="{x:Bind helpers:BindHelpers.DimWhenOff(ViewModel.WifiOn), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource FenpoOkBrush}" />
                                        <FontIcon Glyph="&#xE701;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.WifiText, Mode=OneWay}" FontSize="13" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipStyle}" Opacity="{x:Bind helpers:BindHelpers.DimWhenOff(ViewModel.UsbOn), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource FenpoTextTertiaryBrush}" />
                                        <FontIcon Glyph="&#xECF0;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.UsbText, Mode=OneWay}" FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </controls:WrapPanel>

                            <!-- These need the iPhone app (DECISIONS #36): visible, with what they need. -->
                            <Grid ColumnSpacing="8" MinHeight="84">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource ActionButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRing, Mode=OneWay}" Command="{x:Bind ViewModel.RingCommand}" x:Uid="Action_Ring">
                                    <StackPanel Spacing="18">
                                        <FontIcon Glyph="&#xE767;" FontSize="20" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Left" />
                                        <Grid>
                                            <TextBlock x:Uid="Action_RingText" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.NotRinging, Mode=OneWay}" />
                                            <TextBlock x:Uid="Action_Ringing" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsRinging, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Button>
                                <!-- Hotspot needs Fenpo on the phone to share its Wi-Fi details; not there yet (DECISIONS #36: shown, not hidden). -->
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" x:Uid="Action_Hotspot">
                                    <StackPanel Spacing="18">
                                        <FontIcon Glyph="&#xE704;" FontSize="20" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Left" />
                                        <TextBlock x:Uid="Action_HotspotText" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" IsEnabled="{x:Bind ViewModel.AppConnected, Mode=OneWay}" Click="OnSendFileClick" x:Uid="Action_SendFile">
                                    <StackPanel Spacing="18">
                                        <FontIcon Glyph="&#xE724;" FontSize="20" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Left" />
                                        <TextBlock x:Uid="Action_SendFileText" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource ActionButtonStyle}" IsEnabled="{x:Bind ViewModel.AppConnected, Mode=OneWay}" Click="OnCameraClick" x:Uid="Action_Camera">
                                    <StackPanel Spacing="18">
                                        <FontIcon Glyph="&#xE722;" FontSize="20" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Left" />
                                        <TextBlock x:Uid="Action_CameraText" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" IsEnabled="{x:Bind ViewModel.CanMirror, Mode=OneWay}" Click="OnMirrorClick" x:Uid="Action_Mirror">
                                    <StackPanel Spacing="18">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Left" />
                                        <TextBlock x:Uid="Action_MirrorText" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recent notifications -->
                <Border Style="{StaticResource FenpoCardStyle}" VerticalAlignment="Top">
                    <StackPanel Padding="0,0,0,6">
                        <Grid Padding="16,14,16,8">
                            <TextBlock x:Uid="Home_RecentNotifications" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                            <HyperlinkButton x:Uid="Home_SeeAll" HorizontalAlignment="Right" Padding="0" FontSize="13" Click="OnSeeAllClick" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentNotifications}" ItemTemplate="{StaticResource NotificationRowTemplate}" />
                        <TextBlock x:Uid="Home_NoNotifications" Style="{StaticResource FenpoCaptionTextStyle}" Margin="16,4,16,12" Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.HasNotifications), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <!-- Now playing -->
                    <Border Style="{StaticResource FenpoCardStyle}" Padding="16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E8577E" Offset="0" />
                                        <GradientStop Color="#4E54C8" Offset="0.5" />
                                        <GradientStop Color="#2F8F6B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FenpoTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource FenpoTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Margin="0,10,0,4" Foreground="{ThemeResource FenpoTextBrush}" />
                                <Grid>
                                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,6,0,0">
                                    <Button Width="34" Height="34" CornerRadius="17" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.PreviousCommand}" x:Uid="Media_Previous">
                                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                                    </Button>
                                    <Button Width="34" Height="34" CornerRadius="17" Padding="0" Background="{ThemeResource FenpoTextBrush}" BorderThickness="0" Command="{x:Bind ViewModel.PlayPauseCommand}" x:Uid="Media_PlayPause">
                                        <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource FenpoCardBrush}" />
                                    </Button>
                                    <Button Width="34" Height="34" CornerRadius="17" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.NextCommand}" x:Uid="Media_Next">
                                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind helpers:BindHelpers.CollapsedWhen(ViewModel.HasTrack), Mode=OneWay}">
                                <TextBlock x:Uid="Home_NothingPlaying" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                                <TextBlock x:Uid="Home_NothingPlayingHint" Style="{StaticResource FenpoCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Recent transfers -->
                    <Border Style="{StaticResource FenpoCardStyle}">
                        <StackPanel>
                            <Grid Padding="16,14,16,8">
                                <TextBlock x:Uid="Home_RecentTransfers" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" />
                                <HyperlinkButton x:Uid="Home_Files" HorizontalAlignment="Right" Padding="0" FontSize="13" Click="OnFilesClick" />
                            </Grid>
                            <TextBlock x:Uid="Home_NoTransfers" Style="{StaticResource FenpoCaptionTextStyle}" Margin="16,0,16,14" Visibility="{x:Bind ViewModel.NoTransfers, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentTransfers}" Margin="16,0,16,8" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransferRowViewModel">
                                        <!-- Design "Son aktarılanlar": file icon, name and state, when. -->
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FenpoAccentSoftBrush}">
                                                <TextBlock Text="{x:Bind Extension}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind When}" Style="{StaticResource FenpoCaptionTextStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
