<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.CameraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fenpo.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="32,28">
            <TextBlock x:Uid="CameraTitle" Style="{StaticResource FenpoPageTitleStyle}" />
            <controls:NeedsAppBanner x:Uid="Camera_NeedsApp" Visibility="{x:Bind ViewModel.NeedsApp, Mode=OneWay}" />

            <!-- Design "Kamera": preview on the left, lens and options on the right. -->
            <Grid ColumnSpacing="16" Opacity="{x:Bind ViewModel.ContentOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind ViewModel.AppConnected, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <!-- Live preview from the phone's camera, with what is going on while it is not live. -->
                    <Grid CornerRadius="8" Background="{ThemeResource FenpoIslandBrush}" Height="300">
                        <MediaPlayerElement x:Name="Preview" AreTransportControlsEnabled="False" Stretch="Uniform" />
                        <StackPanel x:Name="PreviewState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="300">
                            <FontIcon Glyph="&#xE722;" FontSize="32" Foreground="{ThemeResource FenpoIslandTextSecondaryBrush}" />
                            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{ThemeResource FenpoIslandTextSecondaryBrush}" />
                            <Button x:Name="PreviewStart" x:Uid="Camera_StartPreview" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnStartClick" />
                        </StackPanel>
                        <Button x:Name="PreviewStop" x:Uid="Camera_StopPreview" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OnStopClick" />
                        <!-- Design ".live": an app is using Fenpo Kamera. -->
                        <Border x:Name="InUseBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="10" Background="{ThemeResource FenpoIslandBrush}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource FenpoDeclineBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="Camera_InUseBadge" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Uid="Camera_Hint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource FenpoCardStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Camera_Lens" Style="{StaticResource FenpoCaptionTextStyle}" />
                            <Border Style="{StaticResource FenpoSegmentBarStyle}">
                                <Grid ColumnSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="LensWide" x:Uid="Camera_LensWide" GroupName="Lens" Style="{StaticResource FenpoSegmentStyle}" Checked="OnLensChecked" />
                                    <RadioButton x:Name="LensUltraWide" x:Uid="Camera_LensUltraWide" Grid.Column="1" GroupName="Lens" Style="{StaticResource FenpoSegmentStyle}" Checked="OnLensChecked" />
                                    <RadioButton x:Name="LensFront" x:Uid="Camera_LensFront" Grid.Column="2" GroupName="Lens" Style="{StaticResource FenpoSegmentStyle}" Checked="OnLensChecked" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FenpoCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource FenpoSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="Camera_CenterStage" Style="{StaticResource FenpoRowLabelStyle}" />
                                    <TextBlock x:Uid="Camera_CenterStageHint" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CenterStage, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Camera_CenterStageToggle" />
                            </Grid>
                            <Border Style="{StaticResource FenpoRowDividerStyle}" />
                            <Grid Style="{StaticResource FenpoSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Camera_Portrait" Style="{StaticResource FenpoRowLabelStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PortraitBlur, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Camera_PortraitToggle" />
                            </Grid>
                            <Border Style="{StaticResource FenpoRowDividerStyle}" />
                            <Grid Style="{StaticResource FenpoSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Camera_Microphone" Style="{StaticResource FenpoRowLabelStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.UseMicrophone, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" x:Uid="Camera_MicrophoneToggle" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Fenpo Kamera for Teams, Zoom, Meet and OBS: installed once with administrator approval (S7). -->
            <Border Style="{StaticResource FenpoCardStyle}" Padding="16,14" Margin="0,16,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B8;" Style="{StaticResource FenpoRowIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Camera_Apps" Style="{StaticResource FenpoRowLabelStyle}" />
                        <TextBlock x:Name="VirtualCameraText" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RemoveCamera" x:Uid="Camera_Remove" Click="OnRemoveCameraClick" />
                        <Button x:Name="InstallCamera" Style="{StaticResource AccentButtonStyle}" Click="OnInstallCameraClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
