<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fenpo.App.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fenpo.App.Controls"
    xmlns:vm="using:Fenpo.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,28">
            <TextBlock x:Uid="FilesTitle" Style="{StaticResource FenpoPageTitleStyle}" />
            <controls:NeedsAppBanner x:Uid="Files_NeedsApp" Visibility="{x:Bind ViewModel.NeedsApp, Mode=OneWay}" />

            <!-- Design "Dosyalar ve fotoğraflar": drop area, transfers, recent photos. -->
            <StackPanel Spacing="16" Opacity="{x:Bind ViewModel.ContentOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind ViewModel.AppConnected, Mode=OneWay}">
                <Grid MinHeight="96" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{ThemeResource FenpoTextTertiaryBrush}" StrokeThickness="1.5" StrokeDashArray="4,3" Fill="{ThemeResource FenpoCardSecondaryBrush}" />
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource FenpoAccentSoftBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="{ThemeResource FenpoAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="Files_DropTitle" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Files_DropHint" Style="{StaticResource FenpoSecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="Files_Pick" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.AppConnected, Mode=OneWay}" Click="OnPickClick" />
                    </Grid>
                </Grid>

                <InfoBar IsOpen="{x:Bind Files.HasNotice, Mode=OneWay}" Message="{x:Bind Files.Notice, Mode=OneWay}" Severity="Informational" IsClosable="False" />

                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel Padding="16,14">
                        <Grid>
                            <TextBlock x:Uid="Files_Transfers" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Uid="Files_OpenFolder" HorizontalAlignment="Right" Padding="4,0" Command="{x:Bind Files.OpenFolderCommand}" />
                        </Grid>
                        <TextBlock x:Uid="Files_NoTransfers" Style="{StaticResource FenpoCaptionTextStyle}" Margin="0,8,0,0" Visibility="{x:Bind Files.IsEmpty, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Files.Transfers}" Margin="0,4,0,0" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransferRowViewModel">
                                    <!-- Design ".xfer": file icon, name and state, progress or result, one action. -->
                                    <Grid Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource FenpoAccentSoftBrush}">
                                            <TextBlock Text="{x:Bind Extension}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource FenpoAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Width="120" VerticalAlignment="Center" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind HasStatus, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource FenpoOkBrush}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource FenpoOkBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="{x:Bind ActionText, Mode=OneWay}" Command="{x:Bind ActCommand}" VerticalAlignment="Center" Visibility="{x:Bind HasAction, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Design "Son fotoğraflar": the phone's library, newest first; drag one to a folder. -->
                <Border Style="{StaticResource FenpoCardStyle}">
                    <StackPanel Padding="16,14" Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="Files_RecentPhotos" FontWeight="SemiBold" Foreground="{ThemeResource FenpoTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="Files_PhotosDragHint" Style="{StaticResource FenpoCaptionTextStyle}" VerticalAlignment="Center" Visibility="{x:Bind Photos.HasItems, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <ProgressRing IsActive="{x:Bind Photos.IsLoading, Mode=OneWay}" Width="16" Height="16" />
                                <HyperlinkButton x:Uid="Files_PhotosRefresh" Padding="4,0" Command="{x:Bind Photos.RefreshCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind Photos.Notice, Mode=OneWay}" Style="{StaticResource FenpoCaptionTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind Photos.HasNotice, Mode=OneWay}" />
                        <GridView ItemsSource="{x:Bind Photos.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPhotoClick" CanDragItems="True" DragItemsStarting="OnPhotosDragStarting" Visibility="{x:Bind Photos.HasItems, Mode=OneWay}">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                    <Grid Width="104" Height="104" CornerRadius="8" Background="{ThemeResource FenpoCardSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border Visibility="{x:Bind IsVideo}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="4,2" CornerRadius="4" Background="{ThemeResource FenpoIslandBrush}">
                                            <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Button x:Uid="Files_PhotosMore" HorizontalAlignment="Center" Command="{x:Bind Photos.LoadMoreCommand}" Visibility="{x:Bind Photos.HasMore, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
