<Project Sdk="Microsoft.NET.Sdk">

  <!-- "Send to phone with Fenpo" in File Explorer's right-click menu: a packaged COM class (IExplorerCommand) that
       Explorer loads in a surrogate process. Published with Native AOT into one DLL that Fenpo.App copies next to
       Fenpo.exe. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Fenpo.ShellExtension</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
