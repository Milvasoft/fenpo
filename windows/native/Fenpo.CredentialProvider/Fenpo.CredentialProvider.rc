#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDB_TILE BITMAP "tile.bmp"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_TITLE "Unlock with Fenpo"
    IDS_IDLE "Approve on your phone with Face ID or your fingerprint"
    IDS_WAITING "Approve on your phone. Fenpo sent it a request."
    IDS_DECLINED "Not approved on the phone. Try again, or sign in with your password."
    IDS_NOT_CONNECTED "Fenpo on this PC cannot reach the phone. Bring the phone closer, or sign in with your password."
    IDS_NOT_PAIRED "Unlocking with the phone has to be set up again: Fenpo › Settings › Unlock with the phone."
    IDS_TIMEOUT "The phone did not answer in time. Try again."
    IDS_FAILED "Fenpo could not unlock. Sign in with your password."
    IDS_RETRY "Ask the phone again"
    IDS_READY "Unlocking…"
END

LANGUAGE LANG_TURKISH, SUBLANG_TURKISH_TURKEY
STRINGTABLE
BEGIN
    IDS_TITLE "Fenpo ile aç"
    IDS_IDLE "Telefonda Face ID ya da parmak iziyle onayla"
    IDS_WAITING "Telefonda onayla. Fenpo telefona istek gönderdi."
    IDS_DECLINED "Telefonda onaylanmadı. Yeniden dene ya da şifrenle giriş yap."
    IDS_NOT_CONNECTED "Bu bilgisayardaki Fenpo telefona ulaşamıyor. Telefonu yaklaştır ya da şifrenle giriş yap."
    IDS_NOT_PAIRED "Telefonla kilit açmayı yeniden kur: Fenpo › Ayarlar › Telefonla kilit aç."
    IDS_TIMEOUT "Telefon zamanında cevap vermedi. Yeniden dene."
    IDS_FAILED "Fenpo kilidi açamadı. Şifrenle giriş yap."
    IDS_RETRY "Telefona yeniden sor"
    IDS_READY "Açılıyor…"
END
